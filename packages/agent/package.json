{
  "name": "@termora/agent",
  "version": "0.2.0",
  "description": "Local Termora agent for PTY sessions, auth, tunnels, SSH/SFTP, and machine control",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/royaluniondesign-sys/termora.git",
    "directory": "packages/agent"
  },
  "homepage": "https://termora.dev",
  "bugs": {
    "url": "https://github.com/royaluniondesign-sys/termora/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "dev": "WEB_PORT=4031 tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "node-pty": "^1.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0"
  }
}
