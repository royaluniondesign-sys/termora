# termora environment configuration
# Copy to .env and fill in your values

# Required: ngrok authentication token (get from https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=

# Optional: Resend API key for magic link email auth
RESEND_API_KEY=

# Optional: Server port (default: 4030)
TERMORA_PORT=4030

# Dev only: port the tunnel forwards to (default: same as TERMORA_PORT).
# `npm run dev` already sets WEB_PORT=4031 so the tunnel hits the Vite dev
# server (which proxies /api and /ws to the agent). Leave this unset in
# production — the agent serves the built web UI itself.
# WEB_PORT=4031

# Optional: JWT secret (auto-generated if not set)
JWT_SECRET=

# Optional: Set to 1 to skip auto-opening browser
TERMORA_NO_OPEN=0
