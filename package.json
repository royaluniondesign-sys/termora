{
  "name": "termora",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Installable mobile and web cockpit for real terminals, SSH/SFTP, multi-machine access, and agent workflows",
  "license": "MIT",
  "author": "termora contributors",
  "homepage": "https://royaluniondesign-sys.github.io/termora/",
  "repository": {
    "type": "git",
    "url": "https://github.com/royaluniondesign-sys/termora.git"
  },
  "bugs": {
    "url": "https://github.com/royaluniondesign-sys/termora/issues"
  },
  "keywords": [
    "terminal",
    "remote-terminal",
    "mobile-terminal",
    "pwa",
    "developer-tools",
    "ssh",
    "sftp",
    "xterm",
    "node-pty",
    "websocket",
    "tmux",
    "typescript",
    "ai-agents",
    "worktrees",
    "git",
    "self-hosted"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@termora/agent --filter=@termora/web --parallel --log-prefix=none --log-order=stream --verbosity=0",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/fix-node-pty.js",
    "check:app-scaffold": "node scripts/check-app-scaffold.mjs",
    "check:desktop-boundary": "node scripts/check-desktop-boundary.mjs",
    "check:desktop-smoke": "node scripts/check-desktop-smoke.mjs",
    "check:platform-readiness": "node scripts/check-platform-readiness.mjs",
    "check:security-audit": "npm audit --omit=dev --audit-level=moderate",
    "check:cockpit": "node scripts/check-cockpit.mjs",
    "package:desktop:unsigned": "node scripts/package-desktop-unsigned.mjs",
    "check:desktop-launch": "node scripts/smoke-desktop-launch.mjs",
    "check:desktop-artifact-preflight": "node scripts/check-desktop-artifact-preflight.mjs",
    "check:web-headless": "node scripts/check-web-headless.mjs",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "check:mobile-scaffold": "npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "body-parser": "1.20.8",
    "ip-address": "10.7.3"
  }
}
